// Destino propuesto: src/BACKEND/server.ts. NO aplicado.
import { crearApp, type SeguridadAplicacion } from './app.js'

// Lo invocará el arranque compartido cuando IAM entregue implementaciones reales.
// Este archivo no inventa un middleware ni arranca una API sin autenticación.
export function iniciarServidor(seguridad: SeguridadAplicacion) {
  const puerto = Number(process.env.PORT ?? 3000)
  if (!Number.isInteger(puerto) || puerto < 1 || puerto > 65535) {
    throw new Error('PORT debe ser un puerto válido.')
  }
  return crearApp(seguridad).listen(puerto, '127.0.0.1', () => {
    console.log(`API compartida disponible en http://127.0.0.1:${puerto}`)
  })
}
