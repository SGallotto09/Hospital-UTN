// Destino propuesto: src/BACKEND/database/connectionDB.ts. NO aplicado.
import mysql, { type Pool, type PoolConnection, type ExecuteValues } from 'mysql2/promise'

export class Database {
  private static instance: Database
  private readonly pool: Pool

  private constructor() {
    const puerto = Number(process.env.DB_PORT ?? 3306)
    if (!Number.isInteger(puerto) || puerto < 1 || puerto > 65535) {
      throw new Error('DB_PORT debe ser un puerto válido.')
    }
    this.pool = mysql.createPool({
      host: process.env.DB_HOST ?? 'localhost',
      port: puerto,
      user: process.env.DB_USER ?? 'root',
      password: process.env.DB_PASSWORD ?? '',
      database: process.env.DB_NAME ?? 'hospital_utn',
      waitForConnections: true,
      connectionLimit: 10,
      multipleStatements: false,
    })
  }

  public static getInstance(): Database {
    if (!Database.instance) Database.instance = new Database()
    return Database.instance
  }

  // Mantiene nombre, argumentos y tupla de resultado usada por los módulos actuales.
  public async query(sql: string, values?: ExecuteValues[]) {
    return this.pool.execute(sql, values)
  }

  public async withTransaction<T>(operacion: (conexion: PoolConnection) => Promise<T>): Promise<T> {
    const conexion = await this.pool.getConnection()
    let descartar = false
    try {
      await conexion.beginTransaction()
      const resultado = await operacion(conexion)
      await conexion.commit()
      return resultado
    } catch (error) {
      try {
        await conexion.rollback()
      } catch (errorRollback) {
        descartar = true
        throw new AggregateError([error, errorRollback], 'Fallaron la transacción y su rollback.')
      }
      throw error
    } finally {
      if (descartar) conexion.destroy()
      else conexion.release()
    }
  }

  public async probarConexion(): Promise<boolean> {
    let conexion: PoolConnection | undefined
    try {
      conexion = await this.pool.getConnection()
      await conexion.ping()
      console.log('Conexión exitosa')
      return true
    } catch {
      console.error('Error al conectar a MySQL')
      return false
    } finally {
      conexion?.release()
    }
  }

  public async cerrar(): Promise<void> { await this.pool.end() }
}
